# ---- server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# true when running behind Caddy/Nginx so req.ip (used for rate limiting) is the real client IP
TRUST_PROXY=false
# comma-separated browser origins allowed by CORS (the Android app doesn't need CORS)
CORS_ORIGINS=

# ---- database (local Postgres, or Supabase: Project Settings > Database > Connection string)
# Supabase: use the *session* pooler (port 5432) or the direct connection, not the transaction pooler (6543)
DATABASE_URL=postgres://vibespace:vibespace@localhost:5432/vibespace
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# true on Render free (no pre-deploy step): apply pending migrations at boot (idempotent, advisory-locked)
RUN_MIGRATIONS_ON_START=false

# ---- auth  (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=vibespace
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# the reset token is appended to this (app deep link or a web page)
PASSWORD_RESET_URL=vibespace://reset-password?token=

# ---- rate limits (requests per minute)
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=60
# post views: recording requests per viewer per minute, new views counted per IP per hour
RATE_LIMIT_VIEWS_PER_MIN=60
VIEWS_MAX_NEW_PER_IP_PER_HOUR=2000

# ---- email: console (logs emails, dev) | resend. Leave MAILER empty = resend if RESEND_API_KEY is set, else console.
# HTTP API only (Render free blocks SMTP ports).
MAILER=
MAIL_FROM=VibeSpace <no-reply@example.com>
RESEND_API_KEY=

# ---- media storage: r2 | s3 (any S3-compatible) | supabase
STORAGE_PROVIDER=r2

# ---- Supabase Storage (STORAGE_PROVIDER=supabase). Make the bucket Public.
# Storage > Settings (S3 configuration): enable the S3 connection, copy the Region, create an access key pair.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=vibespace-media
# s3 = presigned PUT via https://<ref>.storage.supabase.co/storage/v1/s3 (default)
# signed-url = Supabase signed upload URL via REST (needs SUPABASE_SERVICE_ROLE_KEY instead of the S3 keys)
SUPABASE_UPLOAD_MODE=s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase free plan caps every file at 50 MB; uploads above that are rejected regardless of MEDIA_MAX_IMAGE_BYTES.

# ---- generic S3 (STORAGE_PROVIDER=s3), e.g. MinIO in dev
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Cloudflare R2 (STORAGE_PROVIDER=r2, S3-compatible). R2 > Manage API tokens > Object Read & Write for the bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vibespace-media
# optional: override the endpoint (e.g. http://localhost:9000 for MinIO in dev)
R2_ENDPOINT=
# public base URL for reading media (R2 custom domain or r2.dev URL), e.g. https://media.example.com
# Supabase: leave empty (defaults to https://<ref>.supabase.co/storage/v1/object/public/<bucket>)
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_UPLOAD_URL_TTL_SECONDS=600
# true in production: HEAD each object in storage before attaching it to a post
MEDIA_VERIFY_UPLOADS=false
